{
  "name": "jupyterlab-graffiti",
  "version": "0.1.0",
  "description": "Jupyter Graffiti interactive screencasts for JupyterLab 3.6",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "license": "BSD-3-Clause",
  "author": "CTS",
  "files": [
    "lib/**/*.{d.ts,js,js.map}",
    "style/**/*.css"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "sideEffects": [
    "style/index.css"
  ],
  "scripts": {
    "build": "tsc",
    "build:labextension": "node scripts/fix-license-plugin.js && jupyter labextension build .",
    "build:all": "tsc && jupyter labextension build .",
    "clean": "rimraf lib tsconfig.tsbuildinfo jupyterlab_graffiti/labextension",
    "test:unit": "tsc && node --test tests/core.test.mjs",
    "test:ui": "cd ui-tests && playwright test"
  },
  "dependencies": {
    "@jupyterlab/application": "^3.6.4",
    "@jupyterlab/apputils": "^3.6.4",
    "@jupyterlab/cells": "^3.6.4",
    "@jupyterlab/codeeditor": "^3.6.4",
    "@jupyterlab/notebook": "^3.6.4",
    "@jupyterlab/services": "^6.6.5",
    "@lumino/widgets": "^1.37.2",
    "lz-string": "^1.5.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^3.6.4",
    "@types/lz-string": "^1.3.34",
    "rimraf": "^3.0.2",
    "typescript": "~5.4.5"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyterlab_graffiti/labextension"
  }
}
